import Stripe from "stripe";

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY);

export default async function handler(req, res) {
  if (req.method !== "POST") {
    res.status(405).send("Method not allowed");
    return;
  }

  try {
    // Expecting { priceId, uid } in the request body
    const { priceId, uid } = req.body;

    const session = await stripe.checkout.sessions.create({
      mode: "payment",
      payment_method_types: ["card"],
      line_items: [{ price: priceId, quantity: 1 }],
      success_url: "https://lab-insight.vercel.app/upgrade.html?session_id={CHECKOUT_SESSION_ID}",
      cancel_url: "https://lab-insight.vercel.app/index.html",
      metadata: { uid }
    });

    res.json({ sessionId: session.id });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
}
